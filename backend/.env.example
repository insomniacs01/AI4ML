# Copy the values you want to persist into backend/.env.local.
# Shell environment variables still override these values.

# --- MLZero cloud runtime ---
AI4ML_MLZERO_PROVIDER_MODE=cloud
AI4ML_MLZERO_PROVIDER_BASE_URL_OVERRIDE=https://codex.miaomiaocode.com/v1
AI4ML_MLZERO_MODEL_ALIAS=gpt-5.4
AI4ML_MLZERO_PROVIDER_WIRE_API=responses
AI4ML_MLZERO_EXECUTION_MODE=python
AI4ML_MLZERO_PYTHON_EXECUTABLE=D:\333\AI4ML\.venv\Scripts\python.exe
AI4ML_MLZERO_OPENAI_API_KEY=YOUR_REAL_API_KEY
# Required before creating or updating stored AI connectors. Use a stable
# project secret of at least 16 bytes; changing it prevents decrypting
# connector API keys that were encrypted with the old value.
AI4ML_CONNECTOR_SECRET_KEY=replace-with-a-stable-random-secret-at-least-16-bytes
AI4ML_MLZERO_MAX_ITERATIONS=6
AI4ML_MLZERO_CONTINUOUS_IMPROVEMENT=true
AI4ML_MLZERO_MIN_CANDIDATE_MODELS=3

# Optional: override where MLZero run artifacts are written.
# Keeping this outside the repo avoids `uvicorn --reload` being triggered by
# MLZero-generated Python files during task execution.
# AI4ML_RUN_OUTPUT_DIR=C:\Users\LENOVO\AppData\Local\AI4ML\mlzero_runs

# Optional: keep backend-side Supabase config here instead of frontend/.env.local.
# AI4ML_SUPABASE_URL=https://your-project.supabase.co
# AI4ML_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
